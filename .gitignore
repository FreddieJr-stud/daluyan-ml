# ============================================================
# Ferry Digital Shadow — .gitignore
# ============================================================

# --- Python ---
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.ipynb_checkpoints/

# --- ML training artifacts (regeneratable, too large for git) ---
Models/artifacts/
catboost_info/
mlruns/
wandb/
*.pt
*.pth
*.ckpt

# Exception: keep the deployable RPi5 bundle (under 100 MB)
!Models/rpi5_bundle/
!Models/rpi5_bundle/**

# --- Raw / partner data ---
Models/files_from_professor/
*.xlsx
*.csv
*.parquet
*.duckdb
*.sqlite
*.db

# --- Environment / secrets ---
.env
.env.local
.env.*.local

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
.superpowers/

# --- Logs ---
*.log

# --- Internal docs (not for public release) ---
REVIEW.md
.claude/
CLAUDE.md
whats-next.md

# --- Explicit keeps ---
!RETRAIN_LOG.md
!Models/RETRAIN_LOG.md
!Models/TRAINING_LOG.md
